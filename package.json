{
  "name": "wow-forever-route-planner",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:cloudflare": "VITE_BASE_PATH=/ npm run build",
    "build:github-pages": "VITE_BASE_PATH=/wow-forever-route-planner/ npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "node server.mjs",
    "sync:data": "node scripts/sync-data.mjs",
    "sync:maps": "node scripts/sync-maps.mjs",
    "sync:all": "npm run sync:data && npm run sync:maps",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:loot": "node scripts/verify-loot.mjs",
    "verify:planner": "node scripts/verify-planner.mjs",
    "verify:ui": "node scripts/verify-site.mjs",
    "verify:prod-smoke": "node scripts/prod-smoke.mjs",
    "verify": "npm run verify:data && npm run verify:loot && npm run verify:planner && npm run build && npm run verify:ui",
    "pages:dev": "npm run build:cloudflare && wrangler pages dev dist",
    "pages:deploy": "npm run build:cloudflare && wrangler pages deploy dist --project-name wow-forever-route-planner",
    "container:up": "docker compose up --build -d",
    "container:verify": "node scripts/prod-smoke.mjs http://127.0.0.1:8091",
    "container:down": "docker compose down"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "playwright-core": "^1.61.0",
    "wow-blp-web": "^0.7.2",
    "wrangler": "^4.127.1"
  }
}
