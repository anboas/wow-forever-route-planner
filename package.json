{
  "name": "wow-forever-route-planner",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run sync:design && vite build && node scripts/build-pages.mjs",
    "build:cloudflare": "VITE_BASE_PATH=/ npm run build",
    "build:github-pages": "VITE_BASE_PATH=/wow-forever-route-planner/ npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "node server.mjs",
    "sync:data": "node scripts/sync-data.mjs",
    "sync:chains": "node scripts/sync-quest-chains.mjs",
    "sync:context": "node scripts/sync-context.mjs",
    "sync:design": "node scripts/sync-design-tokens.mjs",
    "sync:addon": "npm run sync:design && node scripts/sync-addon-data.mjs",
    "sync:maps": "node scripts/sync-maps.mjs",
    "sync:all": "npm run sync:design && npm run sync:context && npm run sync:chains && npm run sync:data && npm run sync:maps && npm run sync:addon",
    "verify:context": "node scripts/verify-context.mjs",
    "verify:companion": "node scripts/verify-companion.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:loot": "node scripts/verify-loot.mjs",
    "verify:gear": "node scripts/verify-gear.mjs",
    "verify:planner": "node scripts/verify-planner.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:ui": "node scripts/verify-site.mjs",
    "verify:prod-smoke": "node scripts/prod-smoke.mjs",
    "report:data-health": "node scripts/report-data-health.mjs",
    "verify": "npm run verify:context && npm run verify:companion && npm run verify:data && npm run verify:loot && npm run verify:gear && npm run verify:planner && npm run build && npm run verify:auth && npm run verify:ui",
    "pages:dev": "npm run build:cloudflare && wrangler pages dev dist",
    "pages:deploy": "npm run build:cloudflare && wrangler pages deploy dist --project-name wow-forever-route-planner",
    "container:up": "docker compose up --build -d",
    "container:verify": "node scripts/prod-smoke.mjs http://127.0.0.1:8091",
    "container:down": "docker compose down"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "luaparse": "^0.3.1",
    "playwright-core": "^1.61.0",
    "sharp": "^0.35.4",
    "wow-blp-web": "^0.7.2",
    "wrangler": "^4.127.1"
  }
}
